# Admits pods into opted-in namespaces only when they match the confidential-runtime contract (pod CREATE).
# Enforced as a native Kubernetes ValidatingAdmissionPolicy, so it holds while Kyverno is down. Kyverno can't
# generate one while it also generates rules for pod controllers, so controllers aren't pre-checked: a
# non-compliant Deployment / Job is accepted, and its pods are rejected (FailedCreate events).
apiVersion: policies.kyverno.io/v1
kind: ValidatingPolicy
metadata:
  name: {{ cc_policy_name }}
  labels:
    app.kubernetes.io/managed-by: ai-solutions
    app.kubernetes.io/part-of: confidential-containers
spec:
  validationActions: [Deny]
  failurePolicy: Fail
  # Also enforce as a native Kubernetes ValidatingAdmissionPolicy: the API server evaluates it itself,
  # so it keeps working while Kyverno is down (Kyverno removes its own webhooks when it stops).
  autogen:
    podControllers:
      controllers: []
    validatingAdmissionPolicy:
      enabled: true
  matchConstraints:
    namespaceSelector:
      matchLabels:
        {{ cc_namespace_label_key }}: "true"
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE"]
        resources: ["pods"]
  variables:
    - name: annotations
      expression: "object.metadata.?annotations.orValue({})"
    - name: allowedKata
      expression: '{{ cc_allowed_kata_annotations | to_json }}'
    - name: extraKata
      expression: "variables.annotations.filter(k, k.startsWith('io.katacontainers.') && !(k in variables.allowedKata))"
    - name: volumes
      expression: "object.spec.?volumes.orValue([])"
    - name: containers
      expression: "object.spec.containers + object.spec.?initContainers.orValue([])"
  validations:
    - expression: "object.spec.?runtimeClassName.orValue('') == '{{ kata_confidential_runtime }}'"
      message: "pods in namespaces labelled {{ cc_namespace_label_key }}=true must use runtimeClassName {{ kata_confidential_runtime }}"
    - expression: "variables.annotations[?'io.katacontainers.config.hypervisor.cc_init_data'].orValue('') == '{{ cc_initdata_b64 }}'"
      message: "pods in namespaces labelled {{ cc_namespace_label_key }}=true must carry the approved initdata from ConfigMap {{ cc_configmap_namespace }}/{{ cc_configmap_name }}"
    - expression: "size(variables.extraKata) == 0"
      messageExpression: "'Kata annotations not allowed in confidential namespaces: ' + variables.extraKata.join(', ')"
    - expression: "variables.volumes.all(v, {{ cc_allowed_volume_types | map('regex_replace', '^(.*)$', 'has(v.\\1)') | join(' || ') }})"
      messageExpression: "'volume types not allowed in confidential namespaces (allowed: {{ cc_allowed_volume_types | join(', ') }}): ' + variables.volumes.filter(v, !({{ cc_allowed_volume_types | map('regex_replace', '^(.*)$', 'has(v.\\1)') | join(' || ') }})).map(v, v.name).join(', ')"
    - expression: "variables.containers.all(c, c.?imagePullPolicy.orValue('') == 'Always')"
      messageExpression: "'confidential pods must use imagePullPolicy: Always (the TD pulls the image itself); not set on: ' + variables.containers.filter(c, c.?imagePullPolicy.orValue('') != 'Always').map(c, c.name).join(', ')"
